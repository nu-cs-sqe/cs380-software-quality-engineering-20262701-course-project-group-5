@startuml
left to right direction
skinparam classAttributeIconSize 0

package "JavaFX UI" {
    class Main {
        +start(stage : Stage) : void
    }
    class ViewRouter {
        -{final} stage : Stage
        +ViewRouter(stage : Stage)
        +show(scene : Scene) : void
    }
    class GameScreenFactory {
        +GameScreenFactory(showLobby : Runnable)
        +create(session : GameSession) : Scene
    }

    class LobbyController {
        +LobbyController(lobbyView : LobbyView, lobbyModel : LobbyModel, viewRouter : ViewRouter, gameSetup : GameSetup, gameScreenFactory : GameScreenFactory)
        ~onStart(players : List<PlayerData>) : void
        -onDataEntry() : void
    }
    class LobbyView {
        +showError(message : String) : void
    }

    class GameTableController {
        +open() : void
        +close() : void
        +update() : void
        -refreshTable() : void
        -onReady() : void
        -onRoll() : void
        -onSelectBuild(type : BuildType) : void
        -onVertexSelected(point : Point) : void
        -onEdgeSelected(endpoints : Set<Point>) : void
        -onHexSelected(center : Point) : void
        -onOpenTrade() : void
        -onCloseTrade() : void
        -onBuyDevelopment() : void
        -onPlayDevelopment(card : Development) : void
        -onChooseYearOfPlenty(cards : List<ResourceStack>) : void
        -onChooseMonopoly(type : Class<? extends ResourceStack>) : void
        -onEndTurn() : void
        -onPlayAgain() : void
    }
    class GameTableView

    class TradeController {
        +open() : void
        +requiredViewer() : Color
        +render(viewer : Color) : Node
        -onOpenProposal() : void
        -onPropose(receiver : Color, give : List<ResourceStack>, receive : List<ResourceStack>) : void
        -onRequestResponse(offerId : int) : void
        -onAccept(offerId : int) : void
        -onDecline(offerId : int) : void
        -onCounter(offerId : int, give : List<ResourceStack>, receive : List<ResourceStack>) : void
        -onFinalize(offerId : int) : void
        -onOpenBankTrade() : void
        -onBankTrade(give : ResourceStack, receive : ResourceStack) : void
        -onClose() : void
    }
    class TradeView

    class RobberyController {
        +render(viewer : Color) : Node
        +onHexSelected(center : Point) : void
        -onVictimSelected(victim : Color) : void
    }
    class RobberyView
    class DiscardController {
        +render(viewer : Color) : Node
        -onDiscard(cards : List<ResourceStack>) : void
    }
    class DiscardView
}

package "Lobby model" {
    class LobbyModel
}

package "Match model" {
    class PlayerData <<record>> {
        color : Color
        name : String
    }
    interface Observer {
        +update() : void
    }
    abstract class Observed {
        +addObserver(observer : Observer) : void
        +removeObserver(observer : Observer) : void
        #notifyObservers() : void
    }
    class GameSetup {
        +createGame(players : List<PlayerData>) : GameSession
    }
    class GameSession {
        .. Match state and scoring ..
        +getActivePlayer() : Color
        +getGamePhase() : GamePhase
        +getTurnPhase() : TurnPhase
        +getBoard() : GameBoard
        +getPlayers() : List<PlayerData>
        +getResourceCardCount(player : Color) : int
        +getDevelopmentCardCount(player : Color) : int
        +getHand(player : Color) : PlayerHand
        +getBankResources() : List<ResourceStack>
        +getBankDevelopmentCount() : int
        +getLastRoll() : OptionalInt
        +getLastProduction() : Map<Color, List<ResourceStack>>
        +getPublicScore(player : Color) : int
        +getAwards(player : Color) : Set<Award>
        +getWinner() : Optional<Color>
        +getFinalScores() : Map<Color, ScoreBreakdown>
        .. Starting placements and regular turns ..
        +getSetupRound() : int
        +getRequiredSetupPiece() : BuildType
        +getLegalSetupLocations() : Set<Location>
        +placeStartingPiece(actor : Color, location : Location) : void
        +rollDice(actor : Color) : int
        +getBuildCosts() : Map<BuildType, List<ResourceStack>>
        +getAffordableBuilds(actor : Color) : Set<BuildType>
        +getLegalBuildLocations(actor : Color, type : BuildType) : Set<Location>
        +build(actor : Color, type : BuildType, location : Location) : void
        +endTurn(actor : Color) : void
        .. Player and bank trades ..
        +isTradingOpen() : boolean
        +getTradeOffers(viewer : Color) : List<TradeOfferSummary>
        +getTradeOffer(viewer : Color, offerId : int) : Optional<TradeOfferSummary>
        +proposeTrade(actor : Color, receiver : Color, give : List<ResourceStack>, receive : List<ResourceStack>) : void
        +acceptTrade(actor : Color, offerId : int) : void
        +declineTrade(actor : Color, offerId : int) : void
        +counterTrade(actor : Color, offerId : int, give : List<ResourceStack>, receive : List<ResourceStack>) : void
        +finalizeTrade(actor : Color, offerId : int) : void
        +getBankTradeRates(actor : Color) : Map<ResourceType, Set<Integer>>
        +tradeWithBank(actor : Color, give : ResourceStack, receive : ResourceStack) : void
        .. Robber ..
        -pendingDiscarders : Deque<Color>
        +getRobberState() : Optional<RobberState>
        +discardForRobber(actor : Color, cards : List<ResourceStack>) : void
        +moveRobber(actor : Color, destination : Hex) : void
        +stealForRobber(actor : Color, victim : Color) : void
        .. Development cards ..
        +getDevelopmentOptions(actor : Color) : DevelopmentOptions
        +buyDevelopment(actor : Color) : Development
        +playDevelopment(actor : Color, card : Development) : void
        +chooseYearOfPlenty(actor : Color, cards : List<ResourceStack>) : void
        +chooseMonopoly(actor : Color, type : Class<? extends ResourceStack>) : void
        +placeFreeRoad(actor : Color, edge : Edge) : void
        .. Internal match flow ..
        -advanceSetupPlacement(location : Location) : void
        -grantStartingResources(player : Color, settlement : Vertex) : void
        -produceResources(roll : int) : void
        -beginRobberFromSeven(actor : Color) : void
        -afterSuccessfulDiscard() : void
        -beginRobberFromKnight(actor : Color) : void
        -requireRobberyActor(actor : Color) : void
        -finishRobberyStep() : void
        -resumeAfterCompletedEffect() : void
        -refreshAwardsAndCheckVictory() : void
    }
    class PlayerHand <<record>> {
        resources : List<ResourceStack>
        developments : List<Development>
    }
    class TradeOfferSummary <<record>> {
        id : int
        proposer : Color
        receiver : Color
        offered : List<ResourceStack>
        requested : List<ResourceStack>
        accepted : boolean
    }
    class RobberState <<record>> {
        nextDiscarder : Optional<Color>
        requiredDiscardCount : int
        legalDestinations : Set<Hex>
        eligibleVictims : Set<Color>
    }
    class DevelopmentOptions <<record>> {
        canBuy : boolean
        playableCards : List<Development>
        pendingEffect : Optional<DevelopmentType>
        roadsRemaining : int
        legalFreeRoads : Set<Edge>
    }
    class TurnState {
        -turnNumber : int
        -turnPhase : TurnPhase
        -resumePhase : Optional<TurnPhase>
        +TurnState(turnOrder : List<Color>)
        +getActivePlayerColor() : Color
        +getTurnOrder() : List<Color>
        +getTurnNumber() : int
        +getGamePhase() : GamePhase
        +getTurnPhase() : TurnPhase
        +isTradingOpen() : boolean
        ~setSetupPlayer(player : Color) : void
        ~beginRegularPlay() : void
        ~beginAction() : void
        ~beginInterrupt(phase : TurnPhase, resume : TurnPhase) : void
        ~advanceTurn() : void
        ~resumeTurn() : void
        ~finishGame() : void
    }
    enum TurnPhase {
        ROLL
        ACTION
        ROBBER
        DEVELOPMENT_CHOICE
    }
    enum GamePhase {
        SETUP
        REGULAR
        GAME_OVER
    }
    interface TradeTurnContext {
        +getActivePlayerColor() : Color
        +isTradingOpen() : boolean
    }
    interface GamePhaseHolder {
        +getGamePhase() : GamePhase
    }
    class GameBoard {
        +findVertex(point : Point) : Optional<Vertex>
        +findEdge(endpoints : Set<Point>) : Optional<Edge>
        +findHex(center : Point) : Optional<Hex>
        +getRobberHex() : Hex
        +moveRobber(destination : Hex) : void
        +getAdjacentBuildingOwners(hex : Hex) : Set<Color>
        +produceResourcesForToken(tokenValue : int) : void
    }
    abstract class Piece
    class Robber {
        +Robber()
    }
    class Dice {
        +roll() : int
    }
    class Bank {
        +Bank(startingResources : List<ResourceStack>, startingDevelopments : List<Development>)
        +addResources(stack : ResourceStack) : void
        +hasResources(stack : ResourceStack) : boolean
        +removeResources(stack : ResourceStack) : void throws NotEnoughInventoryException
        +drawDevelopment() : Development throws NotEnoughInventoryException
        +hasDevelopmentsRemaining() : boolean
        +getResourceCount(resourceType : Class<? extends ResourceStack>) : int
        +getDevelopmentCount() : int
    }
    interface ResourceInventory {
        +addResources(stack : ResourceStack) : void
        +hasResources(stack : ResourceStack) : boolean
        +removeResources(stack : ResourceStack) : void throws NotEnoughInventoryException
    }
    class BankResourceDistributor {
        +BankResourceDistributor(playerInventories : Map<Color, ResourceInventory>, bank : Bank)
        +produceResources(player : Color, cards : List<ResourceStack>) : void
