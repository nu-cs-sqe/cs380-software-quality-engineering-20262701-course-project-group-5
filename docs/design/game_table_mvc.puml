        +removeResourcesToDiscard(color : Color, cards : List<ResourceStack>) : void
        +getTargetDiscardQuantity(color : Color) : int
        +isDiscardQuantityMet(targetQuantity : int, color : Color) : boolean
        +discardResources(color : Color) : void
