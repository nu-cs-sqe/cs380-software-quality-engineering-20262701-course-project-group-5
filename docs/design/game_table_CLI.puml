@startuml

' Reuse the desktop diagram's model and replace its graphical UI with the console UI.
!include game_table.puml
remove game_table.ui

title CATAN CLI design
caption Yellow borders identify CLI components. The domain model is shared with the desktop design.

<style>
classDiagram {
  .added {
    LineColor #181818
    LineThickness 0.5
  }
  .console {
    LineColor #FFD700
    LineThickness 2
  }
}
</style>
hide <<console>> stereotype

package game_table.cli <<console>> {
    +class CliMain <<console>> {
        +{static} main(args : String[]) : void
    }

    +class ConsoleController <<console>> {
        -{final} view : ConsoleView
        -{final} setup : GameSetup
        -game : GameSession
        -hexesById : Map<Integer, Hex>
        -verticesById : Map<Integer, Vertex>
        -edgesById : Map<Integer, Edge>
        +ConsoleController(view : ConsoleView, setup : GameSetup)
        +run() : void
        -readPlayers() : Optional<List<PlayerData>>
        -assignBoardIds(board : GameBoard) : void
        -renderBoard() : void
        -placeStartingPieces() : void
        -runTurn() : void
        -runActionMenu(actor : Color) : void
        -buildAtLocation(actor : Color) : void
        -runPlayerTrade(actor : Color) : void
        -promptTradeResponse(offer : TradeOffer) : void
        -runBankTrade(actor : Color) : void
        -resolveRobber() : void
        -playDevelopment(actor : Color) : void
        -resolveDevelopmentChoice(actor : Color) : void
        -chooseFor(player : Color, options : List<String>) : OptionalInt
    }

    +class ConsoleView <<console>> {
        -{final} input : BufferedReader
        -{final} output : PrintWriter
        +ConsoleView(input : BufferedReader, output : PrintWriter)
        +readLine(prompt : String) : Optional<String>
        +showMenu(player : Color, options : List<String>) : void
        +showBoard(hexes : Map<Integer, String>, vertices : Map<Integer, String>, edges : Map<Integer, String>) : void
        +showHand(player : Color, resources : List<ResourceStack>, cards : List<DevelopmentType>) : void
        +showMessage(message : String) : void
        +showError(message : String) : void
        +showResults(winner : Color, scores : Map<Color, ScoreBreakdown>) : void
    }
}

CliMain --> ConsoleController : starts console loop
ConsoleController "1" --> "1" ConsoleView
ConsoleController --> GameSetup : creates match
ConsoleController --> GameSession : reads state and submits actions

@enduml
