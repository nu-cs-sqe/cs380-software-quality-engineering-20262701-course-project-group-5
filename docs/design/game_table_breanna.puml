@startuml
title Catan - Class Design v2 (Breanna)

package common {

    interface Observer {
        +update() : void
    }

    enum Color {
        RED
        BLUE
        ORANGE
        WHITE
    }

}

package game_table {

package ui {

    class GameTableController {
        +rollDice() : void
        +buildSettlement(VertexPoint) : void
        +buildCity(VertexPoint) : void
        +buildRoad(Edge) : void
        +endTurn() : void
    }

    class GameTableView {
        +render() : void
    }

}

package domain {

    enum GamePhase {
        SETUP
        ROLL
        TRADE_BUILD
        END_TURN
    }

    class GameTable {
        -phase : GamePhase
        -currentPlayer : GamePlayer
        +addObserver(Observer) : void
        +notifyObservers() : void
        +rollDice() : void
        +nextTurn() : void
        +getWinner() : GamePlayer
    }

    class Dice {
        +roll() : int
    }

    class TradeOffer {
        -offered : Map<ResourceType, int>
        -requested : Map<ResourceType, int>
    }

    class TradeManager {
        -requester : GamePlayer
        -offerer :
        +determineTradeType(requester: GamePlayer, offerer: )
        +finalizeTrade(request : TradeRequest) : void
        +rejectTrade(request : TradeRequest) : void
        -validateTrade(request : TradeRequest) : boolean
    }

    class PlayerTrade
    {
        -requester : GamePlayer
        -pendingRequests : List<TradeRequest>
        -playerWants : Map<GamePlayer, List<TradeOffer>>
        +tradeOffersOfResourceType(resource : ResourceType) : Map<GamePlayer, List<TradeOffer>>
        +announceWants(offer : TradeOffer, owner : GamePlayer) : void
        +revokeWants(offer : TradeOffer, owner : GamePlayer) : void
        +requestOffer(requester : GamePlayer, owner : GamePlayer, offer : TradeOffer) : void
        +peekTradeOffers() : Map<GamePlayer, List<TradeOffer>>
    }

    class SupplyTrade
    {
        -requester : GamePlayer
        -supply : Bank
        +requestOfferSupply(requester:GamePlayer, harbor:Bank, offer : TradeOffer): void
        +requestOfferHarbor(requester:GamePlayer, supply:Bank, , offer : TradeOffer): void
        -isHarbor(supplier: boolean)
    }

    class TradeRequest {
        -requester : GamePlayer
        -owner : GamePlayer
        -offer : TradeOffer
    }

    interface ResourceOwner {
        +addResources(ResourceType, int) : void
    }

    class GamePlayer {
        -name : String
        -color : Color
        +addResources(ResourceType, int) : void
        +getVictoryPoints() : int
    }

    class Bank {
        +addResources(ResourceType, int) : void
        +drawDevelopmentCard() : DevelopmentCard
    }

    class PlayerHand {
        -resourceCounts : Map<ResourceType, int>
        +addResources(ResourceType, int) : void
        +removeResources(ResourceType, int) : void
        +count(ResourceType) : int
    }

    enum ResourceType {
        WOOD
        BRICK
        WOOL
        GRAIN
        ORE
    }

    enum TerrainType {
        FOREST
        HILLS
        PASTURE
        FIELDS
        MOUNTAINS
        DESERT
    }

    enum BuildType {
        ROAD
        SETTLEMENT
        CITY
        +getCost() : Map<ResourceType, int>
        +getMaxPieces() : int
    }

    class DevelopmentCard {
        -boughtThisTurn : boolean
        -played : boolean
    }

    enum DevelopmentCardType {
        KNIGHT
        VICTORY_POINT
        ROAD_BUILDING
        YEAR_OF_PLENTY
        MONOPOLY
    }

    abstract class Plaque {
        -holder : GamePlayer
        +victoryPoints : int = 2
        +transferTo(GamePlayer) : void
    }

    class LongestRoadPlaque {
    }

    class LargestArmyPlaque {
    }

    class GameBoard {
        +getRobberHex() : Hex
        +moveRobber(Hex) : void
    }

    class Hex {
        -diceNumber : int
        +produceResources() : void
    }

    class VertexPoint {
        +isFree() : boolean
        +getBuilding() : Building
        +getNeighbors() : List<VertexPoint>
        +getEdges() : List<Edge>
    }

    class Edge {
        +isFree() : boolean
        +getRoad() : Road
        +getEndpoints() : List<VertexPoint>
    }

    class BuildManager {
        +getValidSettlementSpots(player : GamePlayer, phase : GamePhase) : List<VertexPoint>
        +getValidCitySpots(player : GamePlayer) : List<VertexPoint>
        +getValidRoadSpots(player : GamePlayer, phase : GamePhase) : List<Edge>
        'build
        +buildSettlement(player : GamePlayer, vertex : VertexPoint, phase : GamePhase) : void
        +buildCity(player : GamePlayer, vertex : VertexPoint) : void
        +buildRoad(player : GamePlayer, edge : Edge, phase : GamePhase) : void
        'checks for validity, ties to highlighting
        -isValidSettlementSpot(player : GamePlayer, vertex : VertexPoint, phase : GamePhase) : boolean
        -isValidCitySpot(player : GamePlayer, vertex : VertexPoint) : boolean
        -isValidRoadSpot(player : GamePlayer, edge : Edge, phase : GamePhase) : boolean
        -isFarEnoughFromBuildings(vertex : VertexPoint) : boolean
        -isVertexConnectedToOwnRoad(player : GamePlayer, vertex : VertexPoint) : boolean
        -isEdgeConnectedToOwnPieces(player : GamePlayer, edge : Edge) : boolean
        -touchesSetupSettlement(player : GamePlayer, edge : Edge) : boolean
        -hasPiecesLeft(player : GamePlayer, type : BuildType) : boolean
        'updates player resources
        -charge(player : GamePlayer, type : BuildType) : void
    }

    class Harbor {
        -resourceType : ResourceType
        +appliesTo(ResourceType) : boolean
        +getTradeRatio() : int
    }

    class Robber {
    }

    abstract class Piece {
        -owner : GamePlayer
    }

    class Road {
    }

    abstract class Building {
        +getProduction() : int
    }

    class Settlement {
        +getProduction() : int
    }

    class City {
        +getProduction() : int
    }

}

}

GameTableController --> GameTableView
GameTableController --> GameTable
GameTableView ..|> Observer
GameTable --> Observer

GameTable --> GamePlayer
GameTable --> GameBoard
GameTable --> Bank
GameTable --> Dice
GameTable --> GamePhase
GameTable --> LongestRoadPlaque
GameTable --> LargestArmyPlaque
'GameTable --> TradeOffer

GameTable --> TradeManager
TradeManager --> TradeOffer
TradeManager --> PlayerTrade
TradeManager --> SupplyTrade
TradeManager --> GamePlayer
TradeManager ..> ResourceType
TradeManager ..> PlayerHand
TradeRequest --> TradeOffer
TradeRequest --> GamePlayer
SupplyTrade-->TradeOffer
PlayerTrade-->TradeRequest

GamePlayer ..|> ResourceOwner
Bank ..|> ResourceOwner
ResourceOwner ..> ResourceType

GamePlayer --> PlayerHand
GamePlayer --> Piece
GamePlayer --> Color

PlayerHand ..> ResourceType
PlayerHand --> DevelopmentCard

Bank --> DevelopmentCard
Bank ..> ResourceType

DevelopmentCard --> DevelopmentCardType

'TradeOffer --> GamePlayer
TradeOffer ..> ResourceType

Plaque --> GamePlayer
LongestRoadPlaque --|> Plaque
LargestArmyPlaque --|> Plaque

GameBoard --> Hex
GameBoard --> VertexPoint
GameBoard --> Edge
GameBoard --> Harbor
GameBoard --> Robber

Hex --> TerrainType
Hex --> VertexPoint
Hex ..> ResourceOwner

VertexPoint --> VertexPoint
VertexPoint --> Edge
VertexPoint --> Building
Edge --> Road

Harbor --> VertexPoint
Harbor --> ResourceType

Piece --> GamePlayer
Road --|> Piece
Building --|> Piece
Settlement --|> Building
City --|> Building

@enduml