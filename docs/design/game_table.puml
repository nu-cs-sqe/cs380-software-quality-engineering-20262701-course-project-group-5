@startuml

package mvc_util {

+interface Observer {
    +update() : void
}

+abstract class Observed {
    -observers : List<Observer>
    +addObserver(observer : Observer) : void
    +removeObserver(observer : Observer) : void
    #notifyObservers() : void
}

}



+enum Color {
    NONE,
    RED,
    BLUE,
    WHITE,
    ORANGE
}

package game_table {

package ui {

    +class GameTableController {
        -{final} view : GameTableView
        -{final} board : GameBoard
        -{final} dice : Dice
        -{final} bank : Bank
        -{final} players : List<GamePlayer>
        +GameTableController()
        +update() : void
        +startPlayerDiceRoll(player : Player) : void
        +startPlayerPlacementTurn(player : Player) : void
        +startPlayerGameTurn(player : Player) : void
    }

    +class GameTableView {
        +update() : void
    }

}

package domain {

    +class Bank {
        -resourceStacks : List<ResourceStack>
        -developments : List<Development>
        +addResources(stack : ResourceStack) : void
        +hasResources(stack : ResourceStack) : boolean
        +removeResources(stack : ResourceStack) : void
        +hasDevelopmentsRemaining() : boolean
        +removeDevelopment() : void
    }

    +class Dice {
        -lastDiceRoll : int
        +Dice(randomSource : Random)
        +roll() : int
        +getLastDiceRoll() : int
    }

    +class ScoreTracker {
        -score : int
        +getScore() : int
        +addScore(score : int) : void
        +removeScore(score : int) : void
    }

package player {

    +class GamePlayer {
        -color : Color
        -victoryPointsTracker : VictoryPointsTracker
        -roadLengthTracker : ScoreTracker
        -armySizeTracker : ScoreTracker
        -inventory : PlayerInventory
        -awards : List<Award>
        +getInventory() : PlayerInventory
        +rollDice(dice : Dice) : void
        +play(item : Playable) : void
        +buy(item : Buyable) : void
        +place(piece : Piece, location : Location) : void
    }

    +class PlayerInventory {
        -pieces : List<Piece>
        -resourceStacks : List<ResourceStack>
        -developments : List<Development>
        +addPiece(piece : Piece) : void
        +hasPiece(piece : Piece) : boolean
        +removePiece(piece : Piece) : void
        +addResources(stack : ResourceStack) : void
        +hasResources(stack : ResourceStack) : boolean
        +removeResources(stack : ResourceStack) : void
        +addDevelopment(development : Development) : void
        +hasDevelopment(development : Development) : boolean
        +removeDevelopment(development : Development) : void
    }

}

package board {

    +class GameBoard {
        -vertices : Set<Vertex>
        -edges : Set<Edge>
        -hexes : Set<Hex>
        +produceResourcesForToken(tokenValue : int) : void
        +addPieceAtLocation(piece : Piece, location : Location) : void
        +removePieceFromLocation(pieceData : PieceData, location : Location) : void
    }

    +abstract class Hex {
        -{final} tokenValue : int
        -vertices : Set<Vertex>
        -edges : Set<Edge>
        -canProduce : boolean
        -products : ResourceProducts
        -occupyingPieces : List<Piece>
        +canProduce() : boolean
        +getTokenValue() : int
        +setCanProduce() : void
        +produceResources() : void
        -sendResourcesToPieces(products : ResourceProducts) : void
    }

    +class HillsHex {
        +produceResources() : void
    }

    +class ForestHex {
        +produceResources() : void
    }

    +class MountainsHex {
        +produceResources() : void
    }

    +class FieldsHex {
        +produceResources() : void
    }

    +class PastureHex {
        +produceResources() : void
    }

    +class DesertHex {
        +setCanProduce() : void
    }

    +class OceanHex {
        +setCanProduce() : void
    }

    +abstract class Location {
        -pieces : List<Piece>
        +getPieceData() : List<PieceData>
        +addPiece(piece : Piece)) : void
        +removePieceWithData(data : PieceData) : void
    }

    +class Vertex {
        -point : Point
        +getPoint() : Point
        +produceResources(products : ResourceProducts) : void
    }

    +class Edge {
        -endpoints : Set<Point>
        +getEndpoints() : Pair<Point, Point>
    }

    +class Point {
        +{final} x : int
        +{final} y : int
    }

}

package piece {

    +abstract class Piece {
        -data : PieceData
        #bankResources : ResourceInventory
        #ownerResources : ResourceInventory
        #ownerPieces : PieceInventory
        +Piece(data : PieceData, bankInventory : ResourceInventory, ownerInventory : ResourceInventory)
        +getPieceData() : PieceData
        +placeEffect() : void
        +removeEffect() : void
    }

    +abstract class Building {
        +produceResources(products : ResourceProducts) : void
    }

    +class PieceData {
        +{final} type : String
        +{final} color : Color
    }

    +class Settlement {
        +produceResources(products : ResourceProducts) : void
        +placeEffect() : void
        +removeEffect() : void
    }

    +class City {
        +produceResources(products : ResourceProducts) : void
        +placeEffect() : void
        +removeEffect() : void
    }

    +class Road {
        +placeEffect() : void
        +removeEffect() : void
    }

    +class Robber {
    }

    +class Harbor {
        -inputTrade : ResourceStack
        +Harbor()
        +Harbor(inputTrade : ResourceStack)
        +getInputTrade() : ResourceStack
    }

    +interface PieceInventory {
        +addPiece(piece : Piece) : void
        +hasPiece(piece : Piece) : boolean
        +removePiece(piece : Piece) : void
    }

}

    +interface Buyable {
        +getCost() : List<ResourceStack>
        +onBoughtEffect() : void
    }

    +interface Playable {
        +onPlayEffect() : void
    }

package resource {

    +abstract class ResourceStack {
        -size : int
        +ResourceStack(initialSize : int)
        +getSize() : int
    }

    +class BrickResourceStack {
    }

    +class LumberResourceStack {
    }

    +class OreResourceStack {
    }

    +class GrainResourceStack {
    }

    +class WoolResourceStack {
    }

    +interface ResourceInventory {
        +addResources(stack : ResourceStack) : void
        +hasResources(stack : ResourceStack) : boolean
        +removeResources(stack : ResourceStack) : void
    }

    +class ResourceProducts {
        -tier1Products : List<ResourceStack>
        -tier2Products : List<ResourceStack>
        +ResourceProducts(tier1Products : List<ResourceStack>, tier2Products : List<ResourceStack>)
        +getTier1Products() : List<ResourceStack>
        +getTier2Products() : List<ResourceStack>
    }

}

package development {

    +abstract class Development {
    }

}

package award {

    +interface Award {
    }

    +class LongestRoadAward {
    }

    +class LargestArmyAward {
    }

}

}

}

Observed --> Observer

GameTableController --> GameTableView
GameTableController ..|> Observer
GameTableView ..|> Observer

GameTableController --> GamePlayer
GameTableController --> GameBoard
GameTableController --> Bank
GameTableController --> Dice

GameBoard --|> Observed
Dice --|> Observed
Bank --|> Observed

Bank ..|> ResourceInventory

GamePlayer --|> Observed
GamePlayer --> ScoreTracker
GamePlayer --> PlayerInventory
GamePlayer ..> Piece
GamePlayer --> Color
GamePlayer --> Award
GamePlayer ..> ResourceStack
ResourceInventory ..> ResourceStack

GameBoard --> Hex
GameBoard --> Vertex
GameBoard --> Edge
GameBoard ..> Location
GameBoard ..> Piece
GameBoard ..> PieceData

Hex --> Piece
Hex --> Vertex
Hex --> Edge

Edge --> Vertex
Edge ..> PieceData

Hex --> ResourceProducts
HillsHex --|> Hex
ForestHex --|> Hex
MountainsHex --|> Hex
FieldsHex --|> Hex
PastureHex --|> Hex
DesertHex --|> Hex
OceanHex --|> Hex

Location --> Piece
Location ..> PieceData
Vertex --> Point
Vertex --|> Location
Edge --> Piece
Edge --> Point
Edge --|> Location
Vertex ..> ResourceProducts

Harbor --> ResourceStack

PlayerInventory ..|> ResourceInventory
PlayerInventory ..|> PieceInventory
PlayerInventory --> ResourceStack
PlayerInventory --> Piece
PlayerInventory --> Bank
PlayerInventory ..> Playable
PlayerInventory ..> Buyable

Building --|> Piece
Settlement --|> Building
Settlement ..|> Buyable
City --|> Building
City ..|> Buyable
Road --|> Piece
Road ..|> Buyable
Robber --|> Piece
Harbor --|> Piece

BrickResourceStack --|> ResourceStack
LumberResourceStack --|> ResourceStack
OreResourceStack --|> ResourceStack
GrainResourceStack --|> ResourceStack
WoolResourceStack --|> ResourceStack

ResourceProducts --> ResourceStack

Piece --> ResourceInventory
Piece --> PieceInventory
Piece ..> ResourceStack
Piece --> Color
Piece --> PieceData
Building ..> ResourceProducts
Settlement ..> ResourceProducts
City ..> ResourceProducts

Settlement --> ScoreTracker
City --> ScoreTracker
Road --> ScoreTracker

PieceData --> Color

Development ..|> Playable
Development ..|> Buyable

LongestRoadAward ..|> Award
LargestArmyAward ..|> Award

@enduml